{
  "name": "corvane-case",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:api\" \"npm:web\"",
    "api": "tsx watch src/server/main.ts",
    "web": "vite --config web/vite.config.ts",
    "pipeline": "tsx scripts/pipeline.ts",
    "llm": "tsx --env-file-if-exists=.env scripts/llm.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:sample": "tsx scripts/label-sample.ts",
    "check": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "verify": "npm run check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.105",
    "@hono/node-server": "^2.1.5",
    "ai": "^7.0.157",
    "csv-parse": "^7.0.3",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
